@using UFF.FichaAnestesica.Domain.Entities
@using System.Globalization

@model AnesthesiaRecord

@{
    string SimNao(bool value) => value ? "Sim" : "Não";

    string EnumFormatado(Enum? valor)
    {
        if (valor == null)
            return "-";

        return System.Text.RegularExpressions.Regex
            .Replace(valor.ToString()!, "([a-z])([A-Z])", "$1 $2");
    }

    // LOGO HOSPITAL
    var hospitalLogoPath = System.IO.Path.Combine(
        Directory.GetCurrentDirectory(),
        "wwwroot",
        "images",
        "logo-huap.png");

    var hospitalLogoBase64 =
        $"data:image/png;base64,{Convert.ToBase64String(System.IO.File.ReadAllBytes(hospitalLogoPath))}";

    // LOGO UFF
    var uffLogoPath = System.IO.Path.Combine(
        Directory.GetCurrentDirectory(),
        "wwwroot",
        "images",
        "logo-uff.png");

    var uffLogoBase64 =
        $"data:image/png;base64,{Convert.ToBase64String(System.IO.File.ReadAllBytes(uffLogoPath))}";
}

<!DOCTYPE html>

<html lang="pt-br">
<head>
    <meta charset="utf-8" />

    <style>

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #222;
            margin: 20px;
        }

        .header {
            border-bottom: 3px solid #1f3c88;
            margin-bottom: 18px;
            padding-bottom: 10px;
        }

        .hospital-name {
            font-size: 24px;
            font-weight: bold;
            color: #1f3c88;
        }

        .document-title {
            font-size: 20px;
            font-weight: bold;
            margin-top: 4px;
        }

        .document-subtitle {
            color: #666;
            font-size: 10px;
            margin-top: 3px;
        }

        .section {
            border: 1px solid #d9d9d9;
            margin-top: 14px;
            border-radius: 6px;
            overflow: hidden;
            page-break-inside: avoid;
        }

        .section-title {
            background: #f1f4f8;
            padding: 8px 12px;
            font-weight: bold;
            font-size: 12px;
            color: #1f3c88;
            border-bottom: 1px solid #d9d9d9;
        }

        .section-content {
            padding: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 6px 8px;
            vertical-align: top;
        }

        .label {
            font-weight: bold;
            color: #444;
            display: block;
            margin-bottom: 2px;
        }

        .value {
            color: #111;
        }

        .tag {
            display: inline-block;
            padding: 2px 8px;
            border: 1px solid #999;
            border-radius: 12px;
            font-size: 10px;
        }

        .check-yes {
            color: #0a7d22;
            font-weight: bold;
        }

        .check-no {
            color: #b00020;
            font-weight: bold;
        }

        .grid-table th {
            background: #f3f3f3;
            border: 1px solid #ccc;
            padding: 8px;
            font-size: 10px;
        }

        .grid-table td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: center;
        }

        .signature-container {
            margin-top: 60px;
        }

        .signature-box {
            width: 45%;
            display: inline-block;
            text-align: center;
        }

        .signature-line {
            border-top: 1px solid #000;
            padding-top: 5px;
            margin-top: 60px;
        }

        .footer {
            margin-top: 40px;
            font-size: 10px;
            color: #777;
        }

    </style>
</head>

<body>

    <!-- CABEÇALHO -->
    <div class="header">

        <table style="width:100%;">
            <tr>

                <!-- LOGO HOSPITAL -->
                <td style="width:140px; vertical-align:middle;">

                    <img src="@hospitalLogoBase64"
                         style="height:70px;" />

                </td>

                <!-- TÍTULO -->
                <td style="text-align:center; vertical-align:middle;">

                    <div class="hospital-name">
                        HOSPITAL UNIVERSITÁRIO ANTÔNIO PEDRO
                    </div>

                    <div class="document-title">
                        FICHA ANESTÉSICA
                    </div>

                    <div class="document-subtitle">
                        Registro anestésico intraoperatório
                    </div>

                </td>

                <!-- ESPAÇO -->
                <td style="width:140px;"></td>

            </tr>
        </table>

    </div>

    <!-- IDENTIFICAÇÃO -->
    <div class="section">

        <div class="section-title">
            IDENTIFICAÇÃO
        </div>

        <div class="section-content">

            <table>
                <tr>

                    <td width="30%">
                        <span class="label">Data do Registro</span>
                        <span class="value">
                            @Model.RecordDate.ToString("dd/MM/yyyy")
                        </span>
                    </td>

                    <td width="35%">
                        <span class="label">Paciente</span>
                        <span class="value">
                            @Model.ExternalPatientId
                        </span>
                    </td>

                    <td width="35%">
                        <span class="label">Classificação ASA</span>

                        <span class="tag">
                            @EnumFormatado(Model.AsaClassification)
                        </span>
                    </td>

                </tr>
            </table>

        </div>

    </div>

    <!-- EQUIPE -->
    <div class="section">

        <div class="section-title">
            EQUIPE CIRÚRGICA
        </div>

        <div class="section-content">

            <table>
                <tr>

                    <td width="33%">
                        <span class="label">Cirurgião</span>
                        @Model.Surgeon
                    </td>

                    <td width="33%">
                        <span class="label">Auxiliar</span>
                        @Model.Assistant
                    </td>

                    <td width="33%">
                        <span class="label">Anestesista</span>
                        @(Model.FirstAnesthesiologist?.Name ?? "-")
                    </td>

                </tr>
            </table>

        </div>

    </div>

    <!-- HORÁRIOS -->
    <div class="section">

        <div class="section-title">
            TEMPOS CIRÚRGICOS
        </div>

        <div class="section-content">

            <table class="grid-table">

                <thead>
                    <tr>
                        <th>Entrada Sala</th>
                        <th>Início Anestesia</th>
                        <th>Fim Cirurgia</th>
                        <th>Fim Anestesia</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>@Model.RoomEntryTime</td>
                        <td>@Model.AnesthesiaStartTime</td>
                        <td>@Model.SurgeryEndTime</td>
                        <td>@Model.AnesthesiaEndTime</td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>

    <!-- SEGURANÇA -->
    <div class="section">

        <div class="section-title">
            SEGURANÇA E AVALIAÇÃO PRÉ-ANESTÉSICA
        </div>

        <div class="section-content">

            <table>

                <tr>

                    <td width="33%">
                        <span class="label">Paciente Identificado</span>

                        <span class="@(Model.PatientIdentifiedBeforeInduction ? "check-yes" : "check-no")">
                            @SimNao(Model.PatientIdentifiedBeforeInduction)
                        </span>
                    </td>

                    <td width="33%">
                        <span class="label">Consentimento Assinado</span>

                        <span class="@(Model.AnestheticConsentSigned ? "check-yes" : "check-no")">
                            @SimNao(Model.AnestheticConsentSigned)
                        </span>
                    </td>

                    <td width="33%">
                        <span class="label">Equipamentos Conferidos</span>

                        <span class="@(Model.AnesthesiaEquipmentChecked ? "check-yes" : "check-no")">
                            @SimNao(Model.AnesthesiaEquipmentChecked)
                        </span>
                    </td>

                </tr>

                <tr>

                    <td>
                        <span class="label">Medicação Pré-Anestésica</span>
                        @SimNao(Model.PreAnestheticMedication)
                    </td>

                    <td>
                        <span class="label">Antibiótico Profilático</span>
                        @SimNao(Model.ProphylacticAntibioticUsed)
                    </td>

                    <td>
                        <span class="label">Dor</span>
                        @SimNao(Model.HasPain)
                    </td>

                </tr>

            </table>

            @if (!string.IsNullOrWhiteSpace(Model.SafetyObservations))
            {
                <div style="margin-top:15px;">

                    <span class="label">
                        Observações de Segurança
                    </span>

                    <div>
                        @Model.SafetyObservations
                    </div>

                </div>
            }

        </div>

    </div>

    <!-- SINAIS VITAIS -->
    <div class="section">

        <div class="section-title">
            SINAIS VITAIS
        </div>

        <div class="section-content">

            <table class="grid-table">

                <thead>
                    <tr>
                        <th>Pressão Arterial</th>
                        <th>Freq. Respiratória</th>
                        <th>Temperatura</th>
                        <th>Saturação O₂</th>
                        <th>Peso</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>@Model.BloodPressure</td>
                        <td>@Model.RespiratoryRate irpm</td>
                        <td>@Model.Temperature °C</td>
                        <td>@Model.OxygenSaturation %</td>
                        <td>@Model.WeightKg kg</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

    <!-- PROCEDIMENTO -->
    <div class="section">

        <div class="section-title">
            PROCEDIMENTO CIRÚRGICO
        </div>

        <div class="section-content">

            <table>

                <tr>

                    <td width="50%">
                        <span class="label">
                            Diagnóstico Pré-Operatório
                        </span>

                        @Model.PreOperativeDiagnosis
                    </td>

                    <td width="50%">
                        <span class="label">
                            Diagnóstico Pós-Operatório
                        </span>

                        @Model.PostOperativeDiagnosis
                    </td>

                </tr>

                <tr>

                    <td>
                        <span class="label">
                            Cirurgia Realizada
                        </span>

                        @Model.SurgeryPerformed
                    </td>

                    <td>
                        <span class="label">
                            Posição Cirúrgica
                        </span>

                        @EnumFormatado(Model.SurgicalPosition)
                    </td>

                </tr>

            </table>

        </div>

    </div>

    <!-- ACESSO VENOSO -->
    <div class="section">

        <div class="section-title">
            ACESSO VENOSO
        </div>

        <div class="section-content">

            <table>

                <tr>

                    <td width="33%">
                        <span class="label">Tipo</span>
                        @EnumFormatado(Model.VenousAccessType)
                    </td>

                    <td width="33%">
                        <span class="label">Local</span>
                        @Model.VenousAccessLocation
                    </td>

                    <td width="33%">
                        <span class="label">Punção Difícil</span>
                        @SimNao(Model.DifficultVenousPuncture)
                    </td>

                </tr>

            </table>

        </div>

    </div>

    <!-- VIA AÉREA -->
    <div class="section">

        <div class="section-title">
            VIA AÉREA E VENTILAÇÃO
        </div>

        <div class="section-content">

            <table>

                <tr>

                    <td width="33%">
                        <span class="label">Anestesia Geral</span>
                        @SimNao(Model.GeneralAnesthesia)
                    </td>

                    <td width="33%">
                        <span class="label">Modo Respiratório</span>
                        @EnumFormatado(Model.RespirationMode)
                    </td>

                    <td width="33%">
                        <span class="label">Ventilação Controlada</span>
                        @EnumFormatado(Model.ControlledVentilationMode)
                    </td>

                </tr>

                <tr>

                    <td>
                        <span class="label">Dispositivo Via Aérea</span>
                        @EnumFormatado(Model.AirwayDeviceType)
                    </td>

                    <td>
                        <span class="label">Número Dispositivo</span>
                        @(Model.AirwayDeviceNumber ?? "-")
                    </td>

                    <td>
                        <span class="label">Dificuldade de Intubação</span>
                        @EnumFormatado(Model.IntubationDifficulty)
                    </td>

                </tr>

            </table>

        </div>

    </div>

    <!-- TÉCNICAS -->
    <div class="section">

        <div class="section-title">
            TÉCNICAS E PROCEDIMENTOS
        </div>

        <div class="section-content">

            <table>

                <tr>
                    <td>Raquianestesia: <strong>@SimNao(Model.SpinalBlockPerformed)</strong></td>
                    <td>Sedação: <strong>@SimNao(Model.SedationPerformed)</strong></td>
                    <td>Suplementação O₂: <strong>@SimNao(Model.OxygenSupplementation)</strong></td>
                </tr>

                <tr>
                    <td>Bloqueio Plexo: <strong>@SimNao(Model.PlexusBlockPerformed)</strong></td>
                    <td>Laringoscopia: <strong>@SimNao(Model.Laryngoscopy)</strong></td>
                    <td>Videolaringoscopia: <strong>@SimNao(Model.VideoLaryngoscopy)</strong></td>
                </tr>

                <tr>
                    <td>Fibroscopia: <strong>@SimNao(Model.Bronchofibroscopy)</strong></td>
                    <td>Traqueostomia: <strong>@SimNao(Model.Tracheostomy)</strong></td>
                    <td>Técnica Retrógrada: <strong>@SimNao(Model.RetrogradeTechnique)</strong></td>
                </tr>

            </table>

        </div>

    </div>

    <!-- RECUPERAÇÃO -->
    <div class="section">

        <div class="section-title">
            RECUPERAÇÃO PÓS-ANESTÉSICA
        </div>

        <div class="section-content">

            <table class="grid-table">

                <thead>
                    <tr>
                        <th>Consciência</th>
                        <th>Atividade</th>
                        <th>Circulação</th>
                        <th>Respiração</th>
                        <th>Saturação</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>@Model.ConsciousnessScore</td>
                        <td>@Model.ActivityScore</td>
                        <td>@Model.CirculationScore</td>
                        <td>@Model.RespirationScore</td>
                        <td>@Model.OxygenSaturationScore</td>

                        <td>
                            <strong>
                                @Model.TotalAldreteKroulikScore
                            </strong>
                        </td>
                    </tr>

                </tbody>

            </table>

            <table style="margin-top:15px;">

                <tr>

                    <td width="50%">

                        <span class="label">
                            Condição Clínica de Alta
                        </span>

                        @EnumFormatado(Model.ClinicalDischargeCondition)

                    </td>

                    <td width="50%">

                        <span class="label">
                            Destino do Paciente
                        </span>

                        @EnumFormatado(Model.Destination)

                    </td>

                </tr>

            </table>

        </div>

    </div>

    <!-- ASSINATURA -->
    <div class="signature-container">

        <div class="signature-box">

            <div class="signature-line">
                @(Model.FirstAnesthesiologist?.Name ?? "Anestesista Responsável")
            </div>

        </div>

        <div class="signature-box" style="float:right;">

            <div class="signature-line">
                Assinatura
            </div>

        </div>

    </div>

    <!-- RODAPÉ -->
    <div class="footer"
         style="
            border-top:1px solid #dcdcdc;
            padding-top:10px;
            margin-top:50px;">

        <table>

            <tr>

                <!-- LOGO UFF -->
                <td style="width:120px;">

                    <img src="@uffLogoBase64"
                         style="height:45px;" />

                </td>

                <!-- TEXTO -->
                <td style="text-align:center; font-size:10px; color:#777;">

                    Documento confidencial hospitalar •
                    Gerado eletronicamente pelo sistema <strong>SIGA</strong>

                </td>

                <!-- DATA -->
                <td style="width:160px; text-align:right; font-size:10px; color:#777;">

                    @DateTime.Now.ToString("dd/MM/yyyy HH:mm")

                </td>

            </tr>

        </table>

    </div>

</body>
</html>