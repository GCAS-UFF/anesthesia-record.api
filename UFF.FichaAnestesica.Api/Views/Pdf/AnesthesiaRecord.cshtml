@using UFF.FichaAnestesica.Domain.Entities
@using System.Globalization

@model AnesthesiaRecord

@{
    string SimNao(bool? value) => value == true ? "Sim" : value == false ? "Não" : "-";

    string EnumFormatado(Enum? valor)
    {
        if (valor == null) return "-";
        return System.Text.RegularExpressions.Regex.Replace(valor.ToString()!, "([a-z])([A-Z])", "$1 $2");
    }

    var hospitalLogoPath = System.IO.Path.Combine(
        Directory.GetCurrentDirectory(),
        "wwwroot",
        "images",
        "logo-huap.png"
    );

    var hospitalLogoBase64 =
        $"data:image/png;base64,{Convert.ToBase64String(System.IO.File.ReadAllBytes(hospitalLogoPath))}";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Ficha Anestésica - HUAP</title>

    <style>
        @@page {
            size: A4;
            margin: 5mm; 
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 8pt; 
            color: #111827;
            margin: 0;
            padding: 0;
            line-height: 1.2;
            background: white;
        }

        /* TABELAS BASE */
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        td, th {
            border: 1px solid #9ca3af;
            padding: 1.5mm 2mm;
            vertical-align: top;
            word-break: break-word;
            font-size: 7.5pt;
        }

      
        .header table td,
        .signature-table td {
            border: none !important;
        }

      
        .header {
            margin-bottom: 1.5mm;
        }

        .hospital-name {
            font-size: 12pt;
            font-weight: bold;
            color: #1e3a8a;
            line-height: 1.1;
        }

        .document-title {
            font-size: 10pt;
            font-weight: bold;
            margin-top: 0.5mm;
        }

     
        .section {
            border: 1px solid #9ca3af;
            border-radius: 1mm;
            overflow: hidden;
            margin-bottom: 2mm;
            page-break-inside: avoid;
        }

        .section-title {
            background: #e5e7eb;
            color: #1e3a8a;
            font-weight: bold;
            font-size: 8.5pt;
            padding: 1.2mm 2mm;
            letter-spacing: 0.2px;
        }

        .section-content {
            padding: 1mm;
        }

  
        .label {
            display: block;
            font-size: 6.5pt;
            font-weight: bold;
            color: #374151;
            margin-bottom: 0.3mm;
            text-transform: uppercase;
        }

        .yes {
            color: #166534;
            font-weight: bold;
        }

        .no {
            color: #991b1b;
            font-weight: bold;
        }

        .small {
            font-size: 6pt;
            color: #4b5563;
        }

      
        .signature-area {
            margin-top: 3mm;
            page-break-inside: avoid;
        }

        .signature-line {
            border-top: 0.5pt solid #111827;
            width: 80%;
            margin: 3mm auto 0 auto;
            padding-top: 1mm;
            text-align: center;
            font-size: 7.5pt;
        }

     
        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 6pt;
            color: #6b7280;
            margin-bottom: 1mm;
        }

        
        .page-break {
            page-break-before: always;
            margin-top: 2mm;
        }

       
        .monitor-table td,
        .monitor-table th {
            height: 4mm;
            font-size: 7pt;
            text-align: center;
            vertical-align: middle;
            padding: 1mm 1mm;
        }

       
        .section, .header, .signature-area {
            page-break-inside: avoid;
        }

       
        .grid-table td, .grid-table th {
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- CABEÇALHO PRIMEIRA PÁGINA -->
    <div class="header">
        <table>
            <tr>
                <td style="width: 18mm;">
                    <img src="@hospitalLogoBase64" style="height: 10mm; width: auto;" alt="Logo HUAP" />
                </td>
                <td style="text-align: center;">
                    <div class="hospital-name">
                        HOSPITAL UNIVERSITÁRIO ANTÔNIO PEDRO
                    </div>
                    <div class="document-title">
                        FICHA ANESTÉSICA
                    </div>
                </td>
                <td style="width: 25mm; text-align: right;">
                    <strong>Data:</strong> @DateTime.Now.ToString("dd/MM/yyyy")<br />
                    <strong>ASA:</strong>
                    <span style="border: 1px solid #9ca3af; padding: 0px 4px; border-radius: 3px; display: inline-block; margin-top: 0.5mm;">
                        III
                    </span>
                </td>
            </tr>
        </table>
    </div>

    <!-- IDENTIFICAÇÃO -->
    <div class="section">
        <div class="section-title">IDENTIFICAÇÃO</div>
        <div class="section-content">
            <table>
                <tr>
                    <td style="width: 34%"><span class="label">Paciente</span>João Silva Santos</td>
                    <td style="width: 16%"><span class="label">Registro</span>456789</td>
                    <td style="width: 18%"><span class="label">Nascimento</span>15/03/1968</td>
                    <td style="width: 12%"><span class="label">Sexo</span>Masculino</td>
                    <td style="width: 20%"><span class="label">Leito</span>405 - 4º Andar</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- SEGURANÇA -->
    <div class="section">
        <div class="section-title">SEGURANÇA / PRÉ-INDUÇÃO</div>
        <div class="section-content">
            <table>
                <tr>
                    <td>Paciente identificado: <span class="yes">Sim</span></td>
                    <td>Consentimento: <span class="yes">Sim</span></td>
                    <td>Equipamentos: <span class="yes">Sim</span></td>
                    <td>Repique: <span class="no">Não</span></td>
                </tr>
                <tr>
                    <td colspan="2"><span class="label">ATB Profilático</span>Cefazolina 2g - 08:10</td>
                    <td colspan="2"><span class="label">Pré-Anestésica</span>Midazolam 3mg IV - 08:05</td>
                </tr>
                <tr>
                    <td colspan="4"><span class="label">Atenção</span>Hipertenso controlado, sem alergias conhecidas.</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- DADOS VITAIS -->
    <div class="section">
        <div class="section-title">DADOS VITAIS</div>
        <div class="section-content">
            <table class="grid-table">
                <tr>
                    <td><span class="label">Entrada</span>08:00</td>
                    <td><span class="label">PA</span>138/82</td>
                    <td><span class="label">FR</span>16</td>
                    <td><span class="label">T°C</span>36.7</td>
                    <td><span class="label">SpO₂</span>97%</td>
                    <td><span class="label">Peso</span>78kg</td>
                    <td><span class="label">ASA</span>III</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- EQUIPE -->
    <div class="section">
        <div class="section-title">EQUIPE / PRÉ-PROCEDIMENTO</div>
        <div class="section-content">
            <table>
                <tr>
                    <td><span class="label">Cirurgião</span>Dr. Carlos Mendes</td>
                    <td><span class="label">Auxiliar</span>Dra. Ana Beatriz</td>
                    <td><span class="label">1º Anestesista</span>Dr. Rafael Costa</td>
                    <td><span class="label">2º Anestesista</span>Dra. Juliana Mendes</td>
                </tr>
                <tr>
                    <td><span class="label">Início Anestesia</span>08:15</td>
                    <td><span class="label">Posição</span>Supina</td>
                    <td><span class="label">Coxins</span>Sim</td>
                    <td><span class="label">Punção Difícil</span>Não</td>
                </tr>
                <tr>
                    <td colspan="2"><span class="label">Acesso Venoso</span>Periférico - Veia Cefálica MSD</td>
                    <td colspan="2"><span class="label">Diagnóstico Pré-Op</span>Colelitíase sintomática</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- TÉCNICA ANESTÉSICA -->
    <div class="section">
        <div class="section-title">TÉCNICA ANESTÉSICA</div>
        <div class="section-content">
            <table>
                <tr>
                    <td>AG: <span class="yes">Sim</span></td>
                    <td>Raqui: <span class="no">Não</span></td>
                    <td>Sedação: <span class="no">Não</span></td>
                    <td>O₂: <span class="yes">Máscara</span></td>
                </tr>
                <tr>
                    <td>Assistida: <span class="no">Não</span></td>
                    <td>Controlada: <span class="yes">Volume</span></td>
                    <td>Absorvedor CO₂: <span class="yes">Sim</span></td>
                    <td>Laringoscopia: <span class="yes">Sim</span></td>
                </tr>
                <tr>
                    <td colspan="2"><span class="label">Via Aérea</span>TOT 7.5 - Fácil</td>
                    <td>Fibroscopia: <span class="no">Não</span></td>
                    <td>Videolaringo: <span class="no">Não</span></td>
                </tr>
                <tr>
                    <td>Plexo: <span class="no">Não</span></td>
                    <td colspan="3"><span class="label">Neuroestimulador</span>Femoral - Agulha Stimuplex</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- PÓS-PROCEDIMENTO -->
    <div class="section">
        <div class="section-title">PÓS-PROCEDIMENTO</div>
        <div class="section-content">
            <table>
                <tr>
                    <td><span class="label">Cirurgia</span>Colecistectomia videolaparoscópica</td>
                    <td><span class="label">Fim Cirurgia</span>09:55</td>
                    <td><span class="label">Fim Anestesia</span>10:05</td>
                </tr>
                <tr>
                    <td colspan="3"><span class="label">Diagnóstico Pós-Op</span>Colelitíase com colecistite crônica</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- ALDERETE E KROULIK -->
    <div class="section">
        <div class="section-title">ALDERETE E KROULIK</div>
        <div class="section-content">
            <table class="grid-table">
                <tr><th>Cons.</th><th>Ativ.</th><th>Circ.</th><th>Resp.</th><th>Sat.</th><th>Total</th></tr>
                <tr><td>2</td><td>2</td><td>2</td><td>2</td><td>2</td><td><strong>10</strong></td></tr>
            </table>
            <table style="margin-top: 1mm;">
                <tr>
                    <td><span class="label">Alta</span>Acordado</td>
                    <td><span class="label">Destino</span>Quarto</td>
                    <td><span class="label">Hora</span>10:20</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- CONDIÇÕES FINAIS -->
    <div class="section">
        <div class="section-title">CONDIÇÕES FINAIS</div>
        <div class="section-content">
            <table>
                <tr>
                    <td style="width: 25%"><span class="label">Dor</span><span class="no">Não</span></td>
                    <td><span class="label">Escalas / Conduta</span>ENV: - | PAINAD: - | BPS: - | Conduta: -</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- ASSINATURAS -->
    <div class="signature-area">
        <table class="signature-table">
            <tr>
                <td style="width: 50%; text-align: center;">
                    <div class="signature-line">
                        Dr. Rafael Costa<br />
                        <span class="small">1º Anestesista</span>
                    </div>
                </td>
                <td style="width: 50%; text-align: center;">
                    <div class="signature-line">
                        Dra. Juliana Mendes<br />
                        <span class="small">2º Anestesista</span>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="2" style="text-align: center; padding-top: 2mm;">
                    <strong>Data:</strong> @DateTime.Now.ToString("dd/MM/yyyy")
                </td>
            </tr>
        </table>
    </div>

    <!-- ========================================= -->
    <!-- QUEBRA DE PÁGINA – MONITORIZAÇÃO          -->
    <!-- ========================================= -->
    <div class="page-break"></div>

    <!-- CABEÇALHO DA SEGUNDA PÁGINA -->
    <div class="header">
        <div style="text-align: center;">
            <strong>MONITORIZAÇÃO INTRAOPERATÓRIA</strong><br />
            <small>Paciente: João Silva Santos | @DateTime.Now.ToString("dd/MM/yyyy")</small>
        </div>
    </div>

    <!-- TABELA DE MONITORIZAÇÃO (COMPACTA, CABE EM UMA PÁGINA) -->
    <div class="section">
        <div class="section-content">
            <table class="grid-table monitor-table">
                <thead>
                    <tr>
                        <th style="width: 12%">Horário</th>
                        <th style="width: 8%">FC</th>
                        <th style="width: 12%">PA</th>
                        <th style="width: 8%">SpO₂</th>
                        <th style="width: 8%">EtCO₂</th>
                        <th style="width: 8%">T°C</th>
                        <th style="width: 44%">Observações</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>08:15</td><td>78</td><td>132/78</td><td>98</td><td>38</td><td>36.5</td><td>Indução</td></tr>
                    <tr><td>08:30</td><td>82</td><td>118/72</td><td>99</td><td>36</td><td>36.4</td><td>Pneumoperitônio</td></tr>
                    <tr><td>09:00</td><td>75</td><td>125/75</td><td>97</td><td>37</td><td>36.3</td><td></td></tr>
                    <tr><td>09:30</td><td>80</td><td>110/68</td><td>98</td><td>35</td><td>36.2</td><td></td></tr>
                    <tr><td>10:00</td><td>72</td><td>128/80</td><td>99</td><td>36</td><td>36.4</td><td>Fim cirurgia</td></tr>
                    <!-- LINHAS VAZIAS PARA REGISTROS MANUAIS – LIMITADAS PARA CABER NA PÁGINA -->
                    @for (int i = 0; i < 12; i++)
                    {
                        <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <footer>
        Documento confidencial • Gerado eletronicamente pelo sistema SIGA • HUAP - UFF • @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </footer>
</body>
</html>