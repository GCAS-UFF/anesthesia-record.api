        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 8px;
            color: #111827;
            margin: 0;
            line-height: 1.15;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        td, th {
            border: 1px solid #cbd5e1;
            padding: 4px 5px;
            vertical-align: top;
            word-wrap: break-word;
            font-size: 8px;
        }

        .header table td,
        .signature-table td {
            border: none !important;
        }

        .header {
            margin-bottom: 5px;
        }

        .hospital-name {
            font-size: 14px;
            font-weight: bold;
            color: #1e3a8a;
            line-height: 1;
        }

        .document-title {
            font-size: 13px;
            font-weight: bold;
            margin-top: 2px;
        }

        .section {
            border: 1px solid #cbd5e1;
            border-radius: 3px;
            overflow: hidden;
            margin-bottom: 5px;
            page-break-inside: avoid;
        }

        .section-title {
            background: #e5e7eb;
            color: #1e3a8a;
            font-weight: bold;
            font-size: 8.5px;
            padding: 4px 6px;
            letter-spacing: .2px;
        }

        .section-content {
            padding: 4px;
        }

        .label {
            display: block;
            font-size: 7px;
            font-weight: bold;
            color: #374151;
            margin-bottom: 1px;
            text-transform: uppercase;
        }

        .grid-table td,
        .grid-table th {
            text-align: center;
        }

        .grid-table th {
            background: #f8fafc;
            font-weight: bold;
        }

        .yes {
            color: #166534;
            font-weight: bold;
        }

        .no {
            color: #991b1b;
            font-weight: bold;
        }

        .small {
            font-size: 7px;
            color: #6b7280;
        }

        .signature-area {
            margin-top: 18px;
        }

        .signature-line {
            border-top: 1px solid #111827;
            width: 82%;
            margin: 22px auto 0 auto;
            padding-top: 4px;
            text-align: center;
            font-size: 8px;
        }

        footer {
            position: fixed;
            bottom: 1px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 6.5px;
            color: #6b7280;
        }

        .page-break {
            page-break-before: always;
        }

        .monitor-table td,
        .monitor-table th {
            height: 18px;
            font-size: 7.6px;
        }
    </style>
</head>

