                    <td colspan="2"><span class="label">Diagnóstico Pré-Operatório</span> Colelitíase sintomática</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- TÉCNICA ANESTÉSICA -->
    <div class="section">
        <div class="section-title">TÉCNICA ANESTÉSICA</div>
        <div class="section-content">
            <table>
                <tr>
                    <td><span class="label">Anestesia Geral</span> <span class="yes">Sim</span></td>
                    <td colspan="3">
                        <span class="label">Respiração</span><br>
                        Assistida: <span class="no">Não</span>
                        Controlada: <span class="yes">Sim</span> - Volume
                    </td>
                </tr>
                <tr>
                    <td><span class="label">Circuito</span><br>Absorvedor CO₂: <span class="yes">Sim</span></td>
                    <td colspan="3">
                        <span class="label">Via Aérea</span><br>
                        Tubo Orotraqueal Nº 7.5 - Tipo: Simples - Fácil
                    </td>
                </tr>
            </table>

            <table style="margin-top:12px;">
                <tr>
                    <td>Raquianestesia: <span class="no">Não</span></td>
                    <td>Sedação: <span class="no">Não</span></td>
                    <td>Suplementação O₂: <span class="yes">Sim</span> (Máscara facial)</td>
                </tr>
                <tr>
                    <td>Bloqueio Plexo: <span class="no">Não</span></td>
                    <td>Neuroestimulador: <span class="yes">Sim</span> (Agulha Stimuplex) - Femoral</td>
                    <td>Laringoscopia: <span class="yes">Sim</span></td>
                </tr>
                <tr>
                    <td>Videolaringoscopia: <span class="no">Não</span></td>
                    <td>Fibroscopia: <span class="no">Não</span></td>
                    <td>Técnica Retrógrada: <span class="no">Não</span></td>
                </tr>
            </table>
        </div>
    </div>

    <!-- PÓS-PROCEDIMENTO -->
    <div class="section">
        <div class="section-title">PÓS-PROCEDIMENTO</div>
        <div class="section-content">
            <table>
                <tr>
                    <td><span class="label">Cirurgia Realizada</span> Colecistectomia videolaparoscópica</td>
                    <td><span class="label">Hora Término Cirurgia</span> 09:55</td>
                    <td><span class="label">Hora Término Anestesia</span> 10:05</td>
                </tr>
                <tr>
                    <td colspan="3"><span class="label">Diagnóstico Pós-Operatório</span> Colelitíase com colecistite crônica</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- ALDERETE E KROULIK -->
    <div class="section">
        <div class="section-title">ÍNDICE DE ALDERETE E KROULIK</div>
        <div class="section-content">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Consciência</th>
                        <th>Atividade</th>
                        <th>Circulação</th>
                        <th>Respiração</th>
                        <th>Saturação</th>
                        <th><strong>TOTAL</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2 (Desperto quando chamado)</td>
                        <td>2 (Mov. 4 extremidades)</td>
                        <td>2 (PA ±20% pré)</td>
                        <td>2 (Respira bem)</td>
                        <td>2 (SpO₂ >92% ar)</td>
                        <td><strong>10</strong></td>
                    </tr>
                </tbody>
            </table>
            <br>
            <table>
                <tr>
                    <td><span class="label">Condição Clínica para Alta</span> Acordado</td>
                    <td><span class="label">Destino</span> Quarto</td>
                    <td><span class="label">Hora</span> 10:20</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- CONDIÇÕES FINAIS -->
    <div class="section">
        <div class="section-title">CONDIÇÕES FINAIS</div>
        <div class="section-content">
            <table>
                <tr>
                    <td>Dor: <span class="no">Não</span></td>
                    <td colspan="2">ENV: - PAINAD: - BPS: - Conduta: -</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- ASSINATURAS -->
    <div style="margin-top:35px;">
        <table class="signature-table" style="width:100%">
            <tr>
                <td style="width:50%; text-align:center;">
                    <div class="signature-line">Dr. Rafael Costa<br><span class="small">1º Anestesista</span></div>
                </td>
                <td style="width:50%; text-align:center;">
                    <div class="signature-line">Dra. Juliana Mendes<br><span class="small">2º Anestesista</span></div>
                </td>
            </tr>
            <tr>
                <td colspan="2" style="text-align:center; padding-top:25px; font-size:11px;">
                    <strong>Data:</strong> 27/05/2026
                </td>
            </tr>
        </table>
    </div>

    <!-- MONITORIZAÇÃO -->
    <div class="page-break"></div>
    <div class="header">
        <div style="text-align:center;">
            <strong>MONITORIZAÇÃO INTRAOPERATÓRIA</strong><br>
            <small>Paciente: João Silva Santos | 27/05/2026</small>
        </div>
    </div>

    <div class="section">
        <div class="section-content">
            <table class="grid-table" style="font-size:9.8px;">
                <thead>
                    <tr>
                        <th>Horário</th>
                        <th>FC</th>
                        <th>PA</th>
                        <th>SpO₂</th>
                        <th>EtCO₂</th>
                        <th>T°C</th>
                        <th>Observações</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>08:15</td><td>78</td><td>132/78</td><td>98</td><td>38</td><td>36.5</td><td>Indução</td></tr>
                    <tr><td>08:30</td><td>82</td><td>118/72</td><td>99</td><td>36</td><td>36.4</td><td>Pneumoperitônio</td></tr>
                    <tr><td>09:00</td><td>75</td><td>125/75</td><td>97</td><td>37</td><td>36.3</td><td></td></tr>
                    <tr><td>09:30</td><td>80</td><td>110/68</td><td>98</td><td>35</td><td>36.2</td><td></td></tr>
                    <tr><td>10:00</td><td>72</td><td>128/80</td><td>99</td><td>36</td><td>36.4</td><td>Fim cirurgia</td></tr>
                    @for (int i = 0; i < 13; i++)
                    {
                        <tr style="height:26px;"><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- RODAPÉ EM TODAS AS PÁGINAS -->
    <footer>
        Documento confidencial • Gerado eletronicamente pelo sistema SIGA • HUAP - UFF • 27/05/2026
    </footer>
</body>
</html>