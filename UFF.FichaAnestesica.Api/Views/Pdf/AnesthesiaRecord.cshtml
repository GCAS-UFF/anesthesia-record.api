@using UFF.FichaAnestesica.Domain.Entities
@using System.Globalization
@model AnesthesiaRecord
@{
    string SimNao(bool? value) => value == true ? "Sim" : value == false ? "Não" : "-";
    string EnumFormatado(Enum? valor)
    {
        if (valor == null) return "-";
        return System.Text.RegularExpressions.Regex.Replace(valor.ToString()!, "([a-z])([A-Z])", "$1 $2");
    }

    var hospitalLogoPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "logo-huap.png");
    var hospitalLogoBase64 = $"data:image/png;base64,{Convert.ToBase64String(System.IO.File.ReadAllBytes(hospitalLogoPath))}";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10.5px;
            color: #1f2937;
            margin: 12px 12px 45px 12px;
            line-height: 1.35;
        }

        .header {
            padding-bottom: 10px;
            margin-bottom: 15px;
        }

        .hospital-name {
            font-size: 18px;
            font-weight: bold;
            color: #1f3c88;
            line-height: 1.1;
        }

        .document-title {
            font-size: 18px;
            font-weight: bold;
            margin-top: 2px;
        }

        .section {
            border: 1px solid #d1d5db;
            margin-top: 12px;
            border-radius: 6px;
            overflow: hidden;
            page-break-inside: avoid;
        }

        .section-title {
            background: #f3f4f6;
            color: #1f3c88;
            font-weight: bold;
            padding: 7px 10px;
            font-size: 12px;
        }

        .section-content {
            padding: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td, th {
            padding: 5px 7px;
            vertical-align: top;
            border: 1px solid #d1d5db;
        }

        .header table td,
        .signature-table td,
        .signature-table th {
            border: none !important;
        }

        .label {
            font-weight: bold;
            color: #374151;
            display: block;
            margin-bottom: 2px;
            font-size: 10px;
        }

        .grid-table td {
            text-align: center;
            font-size: 10px;
        }

        .yes {
            color: #15803d;
            font-weight: bold;
        }

        .no {
            color: #b91c1c;
            font-weight: bold;
        }

        .small {
            font-size: 9.5px;
            color: #6b7280;
        }

        .signature-line {
            margin-top: 45px;
            padding-top: 5px;
            text-align: center;
            font-size: 11px;
            border-top: 1px solid #333;
        }

        footer {
            position: fixed;
            bottom: 8px;
            left: 0;
            right: 0;
            font-size: 9px;
            color: #6b7280;
            text-align: center;
            border-top: 1px solid #d1d5db;
            padding-top: 6px;
            margin: 0 12px;
            background: white;
        }

        @@media print {
            footer {
                position: fixed;
                bottom: 8px;
            }
        }

        .page-break {
            page-break-before: always;
        }
    </style>
</head>
<body>
    <!-- CABEÇALHO -->
    <div class="header">
        <table>
            <tr>
                <td style="width:120px;"><img src="@hospitalLogoBase64" style="height:65px;" /></td>
                <td style="text-align:center;">
                    <div class="hospital-name">HOSPITAL UNIVERSITÁRIO ANTÔNIO PEDRO</div>
                    <div class="document-title">FICHA ANESTÉSICA</div>
                </td>
                <td style="width:140px; text-align:right; font-size:11px;">
                    <strong>Data:</strong> 27/05/2026<br>
                    <strong>ASA:</strong> <span style="border:1px solid #6b7280; padding:2px 8px; border-radius:12px;">III</span>
                </td>
            </tr>
        </table>
    </div>

    <!-- IDENTIFICAÇÃO -->
    <div class="section">
        <div class="section-title">IDENTIFICAÇÃO DO PACIENTE</div>
        <div class="section-content">
            <table>
                <tr>
                    <td><span class="label">Nome Completo</span> João Silva Santos</td>
                    <td><span class="label">Registro</span> 456789</td>
                    <td><span class="label">Data de Nascimento</span> 15/03/1968</td>
                    <td><span class="label">Sexo</span> Masculino</td>
                </tr>
                <tr>
                    <td><span class="label">Leito / Andar</span> 405 - 4º Andar</td>
                    <td colspan="3"><span class="label">Convênio</span> SUS</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- SEGURANÇA DO PACIENTE -->
    <div class="section">
        <div class="section-title">SEGURANÇA DO PACIENTE / PRÉ-INDUÇÃO</div>
        <div class="section-content">
            <table>
                <tr>
                    <td>Paciente identificado: <span class="yes">Sim</span></td>
                    <td>Consentimento assinado: <span class="yes">Sim</span></td>
                    <td>Equipamentos checados: <span class="yes">Sim</span></td>
                </tr>
                <tr>
                    <td>Antibiótico Profilático: <span class="yes">Sim</span> (Cefazolina 2g - 08:10)</td>
                    <td colspan="2">
                        Medicação Pré-Anestésica: <span class="yes">Sim</span>
                        <span class="small">(Midazolam 3mg - 08:05 - IV)</span>
                    </td>
                </tr>
                <tr>
                    <td>Repique: <span class="no">Não</span></td>
                    <td colspan="2"><span class="label">Atenção:</span> Hipertenso controlado, sem alergias conhecidas.</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- DADOS VITAIS -->
    <div class="section">
        <div class="section-title">DADOS VITAIS E ANTROPOMÉTRICOS (Antes da indução)</div>
        <div class="section-content">
            <table class="grid-table">
                <tr>
                    <td><span class="label">Hora Entrada Sala</span><br>08:00</td>
                    <td><span class="label">PA</span><br>138/82 mmHg</td>
                    <td><span class="label">FR</span><br>16 irpm</td>
                    <td><span class="label">T°C</span><br>36.7</td>
                    <td><span class="label">SpO₂</span><br>97 %</td>
                    <td><span class="label">Peso</span><br>78 kg</td>
                    <td><span class="label">ASA</span><br>III</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- EQUIPE E PRÉ-PROCEDIMENTO -->
    <div class="section">
        <div class="section-title">EQUIPE CIRÚRGICA E PRÉ-PROCEDIMENTO</div>
        <div class="section-content">
            <table>
                <tr>
                    <td><span class="label">Cirurgião</span> Dr. Carlos Mendes</td>
                    <td><span class="label">Auxiliar</span> Dra. Ana Beatriz</td>
